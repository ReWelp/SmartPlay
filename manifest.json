{
  "manifest_version": 3,
  "name": "SmartPlay",
  "version": "1.3.0",
  "description": "Intelligent YouTube playback — skip silence, adaptive speed, save time.",
  "browser_specific_settings": {
    "gecko": {
      "id": "smartplay@rewelp.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [],
        "optional": []
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": [
        "utils/compat.js",
        "utils/constants.js",
        "utils/storage.js",
        "utils/messaging.js",
        "content/audio-analyzer.js",
        "content/silence-skipper.js",
        "content/speed-controller.js",
        "content/transcript-fetcher.js",
        "content/filler-trimmer.js",
        "content/chapter-reader.js",
        "content/mode-detector.js",
        "content/channel-memory.js",
        "content/time-tracker.js",
        "content/index.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://m.youtube.com/watch*"],
      "js": [
        "utils/compat.js",
        "utils/constants.js",
        "utils/storage.js",
        "utils/messaging.js",
        "content/audio-analyzer.js",
        "content/silence-skipper.js",
        "content/speed-controller.js",
        "content/transcript-fetcher.js",
        "content/filler-trimmer.js",
        "content/chapter-reader.js",
        "content/mode-detector.js",
        "content/channel-memory.js",
        "content/time-tracker.js",
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "scripts": ["utils/compat.js", "background/service-worker.js"],
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
